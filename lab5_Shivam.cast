[2250.465281, "o", "\r\n"]
[2250.923097, "o", "module: ietf-routing"]
[2250.924214, "o", "\r\n"]
[2250.924671, "o", "  +--ro routing-state"]
[2250.92504, "o", "\r\n"]
[2250.925621, "o", "  |  +--ro routing-instance* [name]"]
[2250.926035, "o", "\r\n"]
[2250.926658, "o", "  |     +--ro name                 string"]
[2250.927065, "o", "\r\n"]
[2250.927481, "o", "  |     +--ro type?                identityref"]
[2250.927887, "o", "\r\n"]
[2250.928303, "o", "  |     +--ro router-id?           yang:dotted-quad"]
[2250.928668, "o", "\r\n"]
[2250.929122, "o", "  |     +--ro interfaces"]
[2250.929492, "o", "\r\n"]
[2250.929941, "o", "  |     |  +--ro interface*   if:interface-state-ref"]
[2250.930342, "o", "\r\n"]
[2250.930865, "o", "  |     +--ro routing-protocols"]
[2250.931262, "o", "\r\n"]
[2250.931708, "o", "  |     |  +--ro routing-protocol* [type name]"]
[2250.932099, "o", "\r\n"]
[2250.93254, "o", "  |     |     +--ro type    identityref"]
[2250.932977, "o", "\r\n"]
[2250.933387, "o", "  |     |     +--ro name    string"]
[2250.933746, "o", "\r\n"]
[2250.934174, "o", "  |     +--ro ribs"]
[2250.934587, "o", "\r\n"]
[2250.935051, "o", "  |        +--ro rib* [name]"]
[2250.935421, "o", "\r\n"]
[2250.935866, "o", "  |           +--ro name              string"]
[2250.936232, "o", "\r\n"]
[2250.93668, "o", "  |           +--ro address-family    identityref"]
[2250.937034, "o", "\r\n"]
[2250.937477, "o", "  |           +--ro default-rib?      boolean {multiple-ribs}?"]
[2250.93786, "o", "\r\n"]
[2250.938341, "o", "  |           +--ro routes"]
[2250.938591, "o", "\r\n"]
[2250.938907, "o", "  |              +--ro route* [destination-prefix]"]
[2250.939538, "o", "\r\n"]
[2250.939862, "o", "  |                 +--ro route-preference?     route-preference"]
[2250.940106, "o", "\r\n"]
[2250.940402, "o", "  |                 +--ro destination-prefix    string"]
[2250.940648, "o", "\r\n"]
[2250.940976, "o", "  |                 +--ro metric?               uint32"]
[2250.941246, "o", "\r\n"]
[2250.942265, "o", "  |                 +--ro next-hop"]
[2250.942568, "o", "\r\n"]
[2250.942882, "o", "  |                 |  +--ro (next-hop-options)"]
[2250.943122, "o", "\r\n"]
[2250.943456, "o", "  |                 |     +--:(simple-next-hop)"]
[2250.943708, "o", "\r\n"]
[2250.944036, "o", "  |                 |     |  +--ro outgoing-interface?   string"]
[2250.944287, "o", "\r\n"]
[2250.944614, "o", "  |                 |     |  +--ro next-hop-address?     string"]
[2250.944853, "o", "\r\n"]
[2250.945164, "o", "  |                 |     +--:(special-next-hop)"]
[2250.94548, "o", "\r\n  |                 |        +--ro special-next-hop?     enumeration"]
[2250.945823, "o", "\r\n  |                 +--ro source-protocol       identityref"]
[2250.946149, "o", "\r\n  |                 +--ro active?               empty"]
[2250.947663, "o", "\r\n  |                 +--ro last-updated?         yang:date-and-time\r\n  |                 +--ro update-source?        string"]
[2250.948023, "o", "\r\n  +--rw routing\r\n"]
[2250.948456, "o", "     +--rw routing-instance* [name]\r\n        +--rw name                 string"]
[2250.948787, "o", "\r\n        +--rw type?                identityref"]
[2250.949156, "o", "\r\n        +--rw enabled?             boolean\r\n        +--rw router-id?           yang:dotted-quad {router-id}?"]
[2250.949511, "o", "\r\n        +--rw description?         string"]
[2250.949875, "o", "\r\n        +--rw interfaces\r\n"]
[2250.950305, "o", "        |  +--rw interface*   if:interface-ref\r\n        +--rw routing-protocols\r\n        |  +--rw routing-protocol* [type name]"]
[2250.950629, "o", "\r\n        |     +--rw type             identityref"]
[2250.950995, "o", "\r\n        |     +--rw name             string\r\n"]
[2250.951375, "o", "        |     +--rw description?     string\r\n        |     +--rw static-routes"]
[2250.95264, "o", "\r\n        +--rw ribs"]
[2250.952961, "o", "\r\n           +--rw rib* [name]"]
[2250.953357, "o", "\r\n              +--rw name              string\r\n              +--rw address-family?   identityref"]
[2250.953773, "o", "\r\n              +--rw description?      string\r\n\r\n"]
[2250.954131, "o", "  augment /if:interfaces-state/if:interface:\r\n    +--ro routing-instance?   string"]
[2250.954453, "o", "\r\n\r\n"]
[2250.95486, "o", "  rpcs:\r\n    +---x fib-route\r\n       +---w input"]
[2250.955199, "o", "\r\n       |  +---w routing-instance-name    string\r\n"]
[2250.955564, "o", "       |  +---w destination-address\r\n       |     +---w address-family    identityref"]
[2250.955879, "o", "\r\n       +--ro output\r\n"]
[2250.957254, "o", "          +--ro route\r\n             +--ro address-family     identityref"]
[2250.9577, "o", "\r\n             +--ro next-hop\r\n             |  +--ro (next-hop-options)\r\n             |     +--:(simple-next-hop)"]
[2250.958077, "o", "\r\n             |     |  +--ro outgoing-interface?   string\r\n             |     |  +--ro next-hop-address?     string"]
[2250.958482, "o", "\r\n             |     +--:(special-next-hop)\r\n             |        +--ro special-next-hop?     enumeration"]
[2250.958813, "o", "\r\n             +--ro source-protocol    identityref"]
[2250.959208, "o", "\r\n             +--ro active?            empty\r\n             +--ro last-updated?      yang:date-and-time"]
[2250.962469, "o", "\r\n"]
