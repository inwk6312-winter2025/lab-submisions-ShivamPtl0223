[4796.974819, "o", "\"username\": \"student\",\r\u001b[6d "]
[4796.975225, "o", "\"password\": \"Meilab123\",\r\u001b[7d "]
[4796.975671, "o", "\"port\": \"22\",}]\r\u001b[8d"]
[4796.976175, "o", "description = 'Description set with Netmiko'\r\u001b[9d"]
